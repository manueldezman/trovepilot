# Mezo testnet (from Mezo docs)
NEXT_PUBLIC_MEZO_RPC_URL="https://rpc.test.mezo.org"
NEXT_PUBLIC_MEZO_CHAIN_ID="31611"
NEXT_PUBLIC_MEZO_EXPLORER_URL="https://explorer.test.mezo.org"

# Deployed by this repo (fill after deploy)
NEXT_PUBLIC_TROVE_PILOT_VAULT_ADDRESS=""
# Optional: when upgrading the vault, set the previous vault address so users can withdraw/migrate.
NEXT_PUBLIC_OLD_TROVE_PILOT_VAULT_ADDRESS=""
# NOTE: MockMarketOracle is an internal dependency of the vault. Users do not need its address.

# Demo mode (local-only)
# When enabled, BTC Up/Down scenarios are executed by a local server-side signer (no MetaMask signing needed).
NEXT_PUBLIC_DEMO_AUTOMATION="0"
DEMO_AUTOMATION_ENABLED="0"
# Server-only (do not expose / commit). Must be the borrower (trove owner) private key for signature flows.
DEMO_BORROWER_PRIVATE_KEY=""

# Always-on collateral listener (server-only)
# Fail-safe default: transactions are disabled unless this is explicitly set to "0".
MONITOR_DRY_RUN="1"
# How often the HTTP RPC is checked for a new Mezo block. Minimum: 1000 ms.
ORACLE_POLL_INTERVAL_MS="5000"
